# ---- Copy to .env.local for local development -------------------------------
# Local mode needs NO cloud: in-memory data, dev sign-in, mock AI, local uploads.
DATA_BACKEND=memory          # memory | firestore
AUTH_MODE=dev                # dev (demo user picker, refused in production) | firebase
AI_MODE=mock                 # mock | gemini
BLOB_MODE=local              # local | gcs

# Session cookie signing key for local dev only (production reads Secret Manager
# via SESSION_SECRET injected by Cloud Run from secret "session-signing-key").
SESSION_SECRET=dev-only-change-me-dev-only-change-me
PICKUP_HMAC_KEY=dev-only-pickup-key-dev-only-pickup-key

# ---- Cloud settings (from infra/generated/infra.env after Phase 2) ------------
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_ESCALATION_MODEL=gemini-4-hydrogen
MEDIA_BUCKET=

# ---- Browser (public) values -------------------------------------------------
NEXT_PUBLIC_AUTH_MODE=dev
NEXT_PUBLIC_MAPS_BROWSER_KEY=
NEXT_PUBLIC_MAPS_MAP_ID=
# Firebase web config (public, from infra/generated/firebase-web-config.js)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
